# ── Required ──────────────────────────────────────────────────────────────────

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID with @userinfobot on Telegram
ALLOWED_USER_IDS=

# ── OpenAI models (optional — defaults shown) ─────────────────────────────────

OPENAI_MODEL_MAIN=gpt-5.4
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_VISION=gpt-5.4
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_WHISPER_MODEL=whisper-1

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379/0

# ── Vault ─────────────────────────────────────────────────────────────────────

VAULT_PATH=/data/vault

# SSH remote for git-syncing vault to GitHub (optional but recommended)
# See README → "SSH deploy key" section
VAULT_GIT_REMOTE=git@github.com:yourname/your-vault.git
VAULT_GIT_SSH_KEY=/run/secrets/vault_ssh_key
VAULT_GIT_USER_NAME=mnemo-bot
VAULT_GIT_USER_EMAIL=mnemo-bot@localhost

# ── LightRAG ──────────────────────────────────────────────────────────────────

LIGHTRAG_STORAGE=/data/lightrag

# ── Misc ──────────────────────────────────────────────────────────────────────

# Your timezone — affects daily notes, scheduling, timestamps
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Minutes of inactivity before a session is auto-closed and saved
SESSION_IDLE_TIMEOUT_MIN=15
